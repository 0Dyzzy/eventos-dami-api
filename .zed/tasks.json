[
    {
        "label": "Maven: Clean Install",
        "command": "mvn clean install -DskipTests",
        "cwd": "$ZED_WORKTREE_ROOT"
    },
    {
        "label": "Maven: Spring Boot Run",
        "command": "mvn spring-boot:run",
        "cwd": "$ZED_WORKTREE_ROOT"
    },
    {
        "label": "Maven: Test",
        "command": "mvn test",
        "cwd": "$ZED_WORKTREE_ROOT"
    },
    {
        "label": "Maven: Package",
        "command": "mvn package -DskipTests",
        "cwd": "$ZED_WORKTREE_ROOT"
    }
]
