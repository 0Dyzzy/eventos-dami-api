# Variables de entorno locales (NO se versiona, ver .gitignore)
# Sin comillas y sin espacios alrededor del "=".

SPRING_DATASOURCE_URL=jdbc:mysql://eventos-dami-database.cz9ihy5blc81.us-east-1.rds.amazonaws.com:3306/eventosdami?sslMode=REQUIRED&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=<PASSWORD>

# --- AWS S3 --------------------------------------------------------------------
AWS_S3_BUCKET=eventos-dami
AWS_REGION=us-east-1

# Copia las tres desde el lab: AWS Details → AWS CLI → Show.
# Sin comillas. El session token es la línea larga. Caduca con el lab:
# cuando falle, pégalas de nuevo y reinicia la aplicación.
AWS_ACCESS_KEY_ID=<ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<SECRET_KEY>
AWS_SESSION_TOKEN=<SESSION_TOKEN>
